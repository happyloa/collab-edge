{
  "name": "collab-edge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.103.1",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.0-beta.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/vitest-plugin": "1.1.13",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "node scripts/check-deploy-budget.mjs && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run && vitest run --config vitest.ui.config.ts && node tests/lint-tooling.mjs",
    "test:e2e": "playwright test",
    "build:showcase": "vite build --config showcase/vite.config.ts",
    "test:showcase": "playwright test --config showcase/playwright.config.ts",
    "cf:typegen": "wrangler types --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "check:vinext": "vinext check",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm check:vinext && pnpm build"
  }
}
