{
  "name": "collab-edge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "7.0.5",
    "@tanstack/react-query": "5.107.1",
    "@vinext/cloudflare": "1.3.4",
    "drizzle-orm": "0.45.4",
    "gsap": "^3.15.1",
    "jose": "^6.2.17",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/vitest-plugin": "1.7.0",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "node scripts/check-deploy-budget.mjs && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run && vitest run --config vitest.ui.config.ts && node tests/lint-tooling.mjs && node tests/dependency-security.mjs && node tests/auth-key-files.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:perf": "node scripts/run-e2e.mjs --performance",
    "capture:demo": "node scripts/run-e2e.mjs --capture-demo",
    "build:showcase": "vite build --config showcase/vite.config.ts",
    "test:showcase": "playwright test --config showcase/playwright.config.ts",
    "cf:typegen": "wrangler types --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "check:vinext": "vinext check",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm check:vinext && pnpm build"
  }
}
